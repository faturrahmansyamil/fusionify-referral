# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# RAHASIA — hanya dipakai di server. Jangan pernah diberi prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Nomor WA admin Fusionify, format 62xxxxxxxxxx (tanpa +)
FUSIONIFY_WHATSAPP_NUMBER=6281200000000
# URL publik (untuk link referral + QR), contoh https://referral.syamxuanify.biz.id
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# RAHASIA — string acak panjang untuk hash IP/visitor (openssl rand -hex 32)
HASH_SALT=change-me-random-string
